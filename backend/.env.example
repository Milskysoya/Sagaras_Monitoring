SUPABASE_URL=https://xxxx.supabase.co
# service_role key: hanya di Jetson, JANGAN masuk ke folder frontend / git
SUPABASE_SERVICE_KEY=
MAVLINK_CONN=/dev/ttyACM0
MAVLINK_BAUD=115200
SEND_INTERVAL=1.0
# titik pojok kiri-bawah kolam & panjang sisinya (meter)
POOL_ORIGIN_LAT=-7.952100
POOL_ORIGIN_LON=112.614500
POOL_SIZE_M=25
CAM_SURFACE_INDEX=0
CAM_UNDERWATER_INDEX=1
